import numpy as np
import matplotlib.pyplot as plt
#Coeficientes físicos reales 
Nx = 100
xr = 1
xl = 0
dx = (xr - xl) / (Nx-1)
c = 900
rho = 2700
k = 210
t = 0
it = 0
dtout = 5
tfin = 60
cfl = 0.01

x = np.arange(xl-dx, xr+2*dx, dx)

T = [0.0 for _ in range(Nx+2)]
TP = [0.0 for _ in range(Nx+2)] #con las fantasmas

def timestep():  #PASO DE TIEMPO
    return cfl * dx**2 * rho * c / k

def inittemperature(T): #CONDICION INICIAL
    for i in range(1,Nx+1):
        T[i] = 100

def boundary(T):   #FRONTERAS sobre las fantasmas
    T[0] = 0
    T[Nx + 1] = 0

def difusion(T, TP, cfl):  #METODO NUMERICO DE DIFERENCIA FINITA
    for i in range(1, Nx + 1): #puras celdas reales
        TP[i] = T[i] + cfl * (T[i + 1] + T[i - 1] - 2 * T[i])
    return TP

def step(T, TP, cfl, t, dt, it, tfin, dtout): #PASO Y ESCRITURA A DISCO
    CU = [T.copy()]
    next_output = dtout

    while t < tfin:
        TP = difusion(T, TP, cfl)
        T = TP.copy()
        boundary(T)
        t += dt
        it += 1
        if t >= next_output:
            CU.append(T.copy())
            next_output += dtout

    print("Simulación terminada con éxito")
    return T, TP, t, it, CU

def output(CU, x, dtout): #GRAFICADOR
    for i, snap in enumerate(CU):
        plt.figure(figsize=(8, 5))
        #plt.plot(x, snap)
        plt.plot(x[1:Nx+1], snap[1:Nx+1])
        plt.xlabel("Posición x (m)")
        plt.ylabel("Temperatura T (°C)")
        plt.title(f'Perfil de temperatura T(x,t) a t = {i * dtout:.2f} s')
        plt.grid()
        plt.show()

