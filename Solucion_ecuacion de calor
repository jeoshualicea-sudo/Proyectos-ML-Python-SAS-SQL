import numpy as np
import matplotlib.pyplot as plt
#Coeficientes físicos reales 
Nx = 100
xr = 1
xl = 0
dx = (xr - xl) / Nx

c = 900
rho = 2700
k = 210
t = 0
it = 0
dtout = 5
tfin = 60
cfl = 0.01

x = np.linspace(xl, xr, Nx + 2)

T = [0.0 for _ in range(Nx + 2)]
TP = [0.0 for _ in range(Nx + 2)]

def timestep():  #PASO DE TIEMPO
    return cfl * dx**2 * rho * c / k

def inittemperature(T): #CONDICION INICIAL
    for i in range(Nx):
        T[i] = 100

def boundary(T):   #FRONTERAS
    T[0] = 0
    T[Nx + 1] = 0

def difusion(T, TP, cfl):  #METODO NUMERICO DE DIFERENCIA FINITA
    for i in range(1, Nx + 1):
        TP[i] = T[i] + cfl * (T[i + 1] + T[i - 1] - 2 * T[i])

    boundary(TP)
    return TP

def step(T, TP, cfl, t, dt, it, tfin, dtout): #PASO Y ESCRITURA A DISCO
    CU = [T.copy()]
    next_output = dtout

    while t < tfin:
        TP = difusion(T, TP, cfl)
        T = TP.copy()

        boundary(T)

        t += dt
        it += 1

        if t >= next_output:
            CU.append(T.copy())
            next_output += dtout

    print("Simulación terminada con éxito")
    return T, TP, t, it, CU

def output(CU, x, dtout): #GRAFICADOR
    for i, snap in enumerate(CU):
        plt.figure(figsize=(8, 5))
        plt.plot(x, snap)
        plt.xlabel('x')
        plt.ylabel('T')
        plt.title(f'Temperatura (t = {i * dtout:.2f} s)')
        plt.grid()
        plt.show()

dt = timestep()

inittemperature(T)
boundary(T)

T, TP, t, it, CU = step(T, TP, cfl, t, dt, it, tfin, dtout)

output(CU, x, dtout)
