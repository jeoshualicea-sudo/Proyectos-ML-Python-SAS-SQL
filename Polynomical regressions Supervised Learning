intro()

def answer_one():
    import numpy as np
    from sklearn.linear_model import LinearRegression
    from sklearn.preprocessing import PolynomialFeatures
    
    # Valores donde queremos hacer las 100 predicciones
    x_p = np.linspace(0, 10, 100).reshape(-1, 1)
    
    # Dividir los datos originales
    X_train, X_test, y_train, y_test = train_test_split(
        x, y, random_state=0)
    # Convertir a vector
    X_train = X_train.reshape(-1, 1)
    X_test = X_test.reshape(-1, 1)
    # Arreglo
    degree_predictions = np.zeros((4, 100))
    # Variable de la fila
    j = 0
    for i in [1, 3, 6, 9]:   
        poly = PolynomialFeatures(degree=i)
        X_train_poly = poly.fit_transform(X_train)
        x_p_poly = poly.transform(x_p)
        polireg = LinearRegression().fit(
            X_train_poly, 
            y_train
        )
        degree_predictions[j, :] = polireg.predict(x_p_poly)
        j += 1
    return degree_predictions
    
answer_one()
def answer_two():
    from sklearn.linear_model import LinearRegression
    from sklearn.preprocessing import PolynomialFeatures

    X_train, X_test, y_train, y_test = train_test_split(
        x, y, random_state=0
    )
 
    X_train = X_train.reshape(-1, 1)
    X_test = X_test.reshape(-1, 1)
    
    # Arreglos para guardar R² de grados 0 a 9
    r2_train = np.zeros(10)
    r2_test = np.zeros(10)
    
    for j, i in enumerate(range(10)):
        poly = PolynomialFeatures(degree=i)
        X_train_poly = poly.fit_transform(X_train)
        X_test_poly = poly.transform(X_test)
        # Entrenar modelo
        polireg = LinearRegression().fit(
            X_train_poly,
            y_train)
        # Guardar R²
        r2_train[j] = polireg.score(
            X_train_poly,
            y_train)
        
        r2_test[j] = polireg.score(
            X_test_poly,
            y_test)
    
    return r2_train, r2_test


answer_two()
def answer_three():
    r2_train, r2_test = answer_two()
    grado = np.arange(10)
    plt.figure(figsize=(8, 5))
    plt.plot(grado, r2_train, marker='o', label='Training R²')
    plt.plot(grado, r2_test, marker='o', label='Test R²')
